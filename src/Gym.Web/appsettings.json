{
  "KeyVault": {
    "Uri": "https://basallo.vault.azure.net/"
  },
  "Database": {
    "Provider": "SqlServer",
    "InitializeOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

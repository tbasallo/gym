@page "/group"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppPage
@inject GroupService Groups
@inject PlaceholderService Placeholders
@inject SampleDataService SampleData
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Group · Gym</PageTitle>

<div class="stack">
    <h1>Group</h1>
    <p class="muted">
        People in a group share schedules and work out in the same session. Any device signed in to the group
        can log sets for everyone in that session. People without an account (kids, guests) can be added by name;
        send them an invite link later and their history comes with them.
    </p>

    @if (Error is not null)
    {
        <div class="alert-x">@Error</div>
    }
    @if (Notice is not null)
    {
        <div class="alert-x ok">@Notice</div>
    }

    @foreach (var g in groups)
    {
        <section class="card-x stack-sm">
            <div class="row-between">
                @if (renamingId == g.Id)
                {
                    <div class="row-gap">
                        <input class="form-control" @bind="nameDraft" />
                        <button class="btn btn-accent btn-sm" @onclick="() => Run(async () => { await Groups.RenameAsync(g.Id, UserId, nameDraft); renamingId = null; })">Save</button>
                        <button class="btn btn-soft btn-sm" @onclick="() => renamingId = null">Cancel</button>
                    </div>
                }
                else
                {
                    <h2 class="mb-0">@g.Name <button class="btn btn-link btn-sm" @onclick="() => { renamingId = g.Id; nameDraft = g.Name; }">Rename</button></h2>
                }
            </div>
            <ul class="list-x">
                @foreach (var m in g.Members.OrderBy(m => m.User.Name))
                {
                    var person = m.User;
                    <li class="stack-sm">
                        <div class="row-between">
                            <div>
                                @if (renamingPersonId == person.Id)
                                {
                                    <div class="row-gap">
                                        <input class="form-control form-control-sm" style="max-width: 220px" @bind="personNameDraft" />
                                        <button class="btn btn-accent btn-sm" @onclick="() => Run(async () => { await Placeholders.RenameAsync(g.Id, UserId, person.Id, personNameDraft); renamingPersonId = null; })">Save</button>
                                        <button class="btn btn-soft btn-sm" @onclick="() => renamingPersonId = null">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-semibold">
                                        @person.Name @(m.UserId == UserId ? "(you)" : "")
                                        @if (person.IsPlaceholder)
                                        {
                                            <span class="pill ms-1">No account</span>
                                        }
                                    </div>
                                }
                                @if (person.IsPlaceholder)
                                {
                                    <div class="muted small num" title="Permanent id; kept when they claim an account">ID @person.Id</div>
                                }
                                else
                                {
                                    <div class="muted small">@person.Email</div>
                                }
                            </div>
                            <div class="row-gap">
                                @if (person.IsPlaceholder && renamingPersonId != person.Id)
                                {
                                    <button class="btn btn-sm btn-soft" @onclick="() => { renamingPersonId = person.Id; personNameDraft = person.DisplayName; }">Rename</button>
                                    <button class="btn btn-sm btn-soft" disabled="@Busy" @onclick="() => Run(() => CreateInvite(g.Id, person.Id), reload: false)">Invite link</button>
                                }
                                @if (m.UserId != UserId)
                                {
                                    <button class="btn btn-sm btn-link text-danger" @onclick="() => Run(() => Groups.RemoveMemberAsync(g.Id, UserId, m.UserId))">Remove</button>
                                }
                            </div>
                        </div>
                        @if (inviteFor == person.Id && inviteLink is not null)
                        {
                            <div class="card-x" style="background: var(--surface-2); padding: 10px">
                                <label class="form-label" for="invite-@person.Id">Send this to @person.Name. It works once and expires in @PlaceholderService.InviteLifetime.Days days.</label>
                                <div class="row-gap">
                                    <input id="invite-@person.Id" class="form-control form-control-sm" style="flex: 1; min-width: 200px" readonly value="@inviteLink" />
                                    <button class="btn btn-sm btn-accent" @onclick="CopyInvite">@(copied ? "Copied" : "Copy")</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Add someone with an account</label>
                    <div class="row-gap">
                        <input class="form-control" style="flex: 1; min-width: 180px" type="email" placeholder="email@example.com" @bind="Invite(g.Id).Email" />
                        <button class="btn btn-soft" disabled="@Busy" @onclick="() => Run(() => Add(g.Id))">Add</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Add someone without an account</label>
                    <div class="row-gap">
                        <input class="form-control" style="flex: 1; min-width: 180px" placeholder="Name" maxlength="50" @bind="Invite(g.Id).Name" @bind:event="oninput" />
                        <button class="btn btn-soft" disabled="@(Busy || string.IsNullOrWhiteSpace(Invite(g.Id).Name))" @onclick="() => Run(() => AddPlaceholder(g.Id))">Add</button>
                    </div>
                </div>
            </div>
        </section>
    }

    @foreach (var g in groups)
    {
        var count = sampleCounts.GetValueOrDefault(g.Id);
        <section class="card-x stack-sm">
            <h3 class="mb-0">Sample workouts · @g.Name</h3>
            <p class="muted small mb-0">
                Fill the charts with made-up sessions (4 a week) for everyone in the group, covering
                every exercise in the group's rotation. They're marked as samples and can be removed in one tap;
                your real workouts aren't touched.
            </p>
            @if (count == 0)
            {
                <div class="row-gap">
                    <select class="form-select" style="width: auto" @bind="sampleWeeks" aria-label="How many weeks">
                        <option value="4">4 weeks</option>
                        <option value="8">8 weeks</option>
                        <option value="12">12 weeks</option>
                    </select>
                    <button class="btn btn-soft" disabled="@Busy" @onclick="() => Run(() => AddSamples(g.Id))">Add sample workouts</button>
                </div>
            }
            else if (confirmRemoveFor == g.Id)
            {
                <div class="row-gap">
                    <span class="small">Remove all @count sample sessions?</span>
                    <button class="btn btn-sm btn-accent" disabled="@Busy" @onclick="() => Run(() => RemoveSamples(g.Id))">Remove</button>
                    <button class="btn btn-sm btn-soft" @onclick="() => confirmRemoveFor = null">Cancel</button>
                </div>
            }
            else
            {
                <div class="row-gap">
                    <span class="pill pill-accent">@count sample sessions</span>
                    <a class="btn btn-sm btn-soft" href="reports">See the charts</a>
                    <button class="btn btn-sm btn-link text-danger" @onclick="() => confirmRemoveFor = g.Id">Remove sample workouts</button>
                </div>
            }
        </section>
    }

    <section class="card-x">
        <h3>@(groups.Count == 0 ? "Create your group" : "Create another group")</h3>
        <div class="row-gap">
            <input class="form-control" style="max-width: 320px" placeholder="e.g. Tony & Maria" @bind="newName" @bind:event="oninput" />
            <button class="btn btn-accent" disabled="@(Busy || string.IsNullOrWhiteSpace(newName))" @onclick="() => Run(async () => { await Groups.CreateAsync(UserId, newName); newName = string.Empty; })">Create</button>
        </div>
    </section>
</div>

@code {
    private sealed class InviteDraft
    {
        public string Email { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private List<WorkoutGroup> groups = [];
    private readonly Dictionary<int, InviteDraft> invites = [];
    private int? renamingId;
    private string nameDraft = "";
    private string newName = "";
    private Dictionary<int, int> sampleCounts = [];
    private int? confirmRemoveFor;
    private int sampleWeeks = 4;
    private string? renamingPersonId;
    private string personNameDraft = "";
    private string? inviteFor;
    private string? inviteLink;
    private bool copied;

    protected override async Task LoadAsync()
    {
        groups = await Groups.GetGroupsAsync(UserId);
        sampleCounts = [];
        foreach (var g in groups)
        {
            sampleCounts[g.Id] = await SampleData.CountAsync(g.Id);
        }
    }

    private async Task AddSamples(int groupId)
    {
        var created = await SampleData.GenerateAsync(groupId, UserId, sampleWeeks);
        Notice = $"Added {created} sample sessions. Open Reports or any exercise to see the charts.";
    }

    private async Task RemoveSamples(int groupId)
    {
        var removed = await SampleData.RemoveAsync(groupId, UserId);
        confirmRemoveFor = null;
        Notice = $"Removed {removed} sample sessions.";
    }

    private InviteDraft Invite(int groupId)
    {
        if (!invites.TryGetValue(groupId, out var draft))
        {
            invites[groupId] = draft = new InviteDraft();
        }

        return draft;
    }

    private async Task AddPlaceholder(int groupId)
    {
        var draft = Invite(groupId);
        var person = await Placeholders.AddAsync(groupId, UserId, draft.Name);
        Notice = $"Added {person.Name}. They can join sessions now; create an invite link whenever they want their own login.";
        draft.Name = "";
    }

    private async Task CreateInvite(int groupId, string personId)
    {
        var relative = await Placeholders.CreateInviteLinkAsync(groupId, UserId, personId);
        inviteFor = personId;
        inviteLink = Nav.ToAbsoluteUri(relative).AbsoluteUri;
        copied = false;
    }

    private async Task CopyInvite()
    {
        copied = inviteLink is not null && await JS.InvokeAsync<bool>("gym.copy", inviteLink);
    }

    private async Task Add(int groupId)
    {
        var draft = Invite(groupId);
        if (await Groups.AddMemberAsync(groupId, UserId, draft.Email) is { } error)
        {
            throw new InvalidOperationException(error);
        }

        Notice = $"Added {draft.Email}.";
        draft.Email = "";
    }
}

@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppPage
@implements IDisposable
@inject ScheduleService Schedules
@inject SessionService Sessions
@inject GroupService Groups
@inject LiveUpdates Live
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Today · Gym</PageTitle>

<div class="stack">
    <div class="row-between">
        <h1 class="mb-0">Hi, @CurrentUser?.Name</h1>
    </div>

    @if (Error is not null)
    {
        <div class="alert-x">@Error</div>
    }

    @if (loaded)
    {
        @foreach (var active in activeSessions)
        {
            <div class="card-x" style="border-color: var(--accent)">
                <div class="row-between">
                    <div>
                        <div class="small-caps">In progress</div>
                        <h2 class="mb-1">@active.Title</h2>
                        <div class="muted small">
                            Started @Local(active.StartedUtc, "h:mm tt") ·
                            @string.Join(" & ", active.Participants.Select(p => p.User.Name))
                        </div>
                    </div>
                    <a class="btn btn-accent btn-lg" href="session/@active.Id">Join session</a>
                </div>
            </div>
        }

        @if (schedules.Count == 0)
        {
            <div class="card-x stack-sm">
                <h2>Let's set things up</h2>
                <p class="muted mb-2">
                    Create a group for the people you train with, then build a rotation of days
                    (or start from a ready-made 4-day rotation and edit it).
                </p>
                <div class="row-gap">
                    @if (groups.Count == 0)
                    {
                        <a class="btn btn-accent" href="group">Create a group</a>
                    }
                    else
                    {
                        <button class="btn btn-accent" disabled="@Busy" @onclick="() => Run(CreateStarter)">Create starter rotation for @groups[0].Name</button>
                    }
                    <a class="btn btn-soft" href="schedules">Build my own schedule</a>
                </div>
            </div>
        }

        @foreach (var schedule in schedules)
        {
            var next = ScheduleService.NextDay(schedule);
            var running = activeSessions.FirstOrDefault(s => s.ScheduleId == schedule.Id);
            var state = Picker(schedule);
            <div class="card-x stack-sm">
                <div class="row-between">
                    <div>
                        <div class="small-caps">@(schedule.Group is null ? "Personal" : schedule.Group.Name) · @schedule.Name</div>
                        @if (next is null)
                        {
                            <h2 class="mb-0">No days yet</h2>
                        }
                        else
                        {
                            <h2 class="mb-0">
                                <span class="muted">Day @next.Order of @schedule.Days.Count ·</span> @next.Name
                            </h2>
                        }
                    </div>
                    <a class="btn btn-soft btn-sm" href="schedules/@schedule.Id">Edit</a>
                </div>

                @if (next is null)
                {
                    <p class="muted mb-0">Add days and exercises to this schedule to start working out.</p>
                }
                else if (running is not null)
                {
                    <a class="btn btn-accent" href="session/@running.Id">Session in progress · Join</a>
                }
                else
                {
                    var day = schedule.Days.FirstOrDefault(d => d.Id == state.DayId) ?? next;
                    <div>
                        <label class="form-label">Day</label>
                        <select class="form-select" value="@day.Id" @onchange="e => state.DayId = int.Parse(e.Value!.ToString()!)">
                            @foreach (var d in schedule.Days)
                            {
                                <option value="@d.Id">#@d.Order @d.Name@(d.Id == next.Id ? " (up next)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="muted small">
                        @if (day.Exercises.Count == 0)
                        {
                            <span>No exercises on this day yet.</span>
                        }
                        else
                        {
                            @string.Join(" · ", day.Exercises.Select(e => $"{e.Exercise.Name} {e.TargetSets}×{e.TargetReps}"))
                        }
                    </div>

                    @if (schedule.Group is not null)
                    {
                        <div>
                            <div class="form-label">Who's working out?</div>
                            <div class="row-gap">
                                @foreach (var member in schedule.Group.Members.OrderBy(m => m.User.Name))
                                {
                                    var id = member.UserId;
                                    <label class="pill" style="padding: 6px 12px; font-size: .9rem; cursor: pointer">
                                        <input type="checkbox" class="form-check-input mt-0 me-1" checked="@state.People.Contains(id)"
                                               @onchange="e => Toggle(state, id, (bool)e.Value!)" />
                                        @member.User.Name
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <button class="btn btn-accent btn-lg w-100" disabled="@(Busy || day.Exercises.Count == 0)"
                            @onclick="() => Run(() => Start(schedule, day.Id, state), reload: false)">
                        Start session
                    </button>
                }
            </div>
        }

        @if (recent.Count > 0)
        {
            <div class="card-x">
                <h3>Recent sessions</h3>
                <ul class="list-x">
                    @foreach (var s in recent)
                    {
                        <li class="row-between">
                            <div>
                                <a href="session/@s.Id" class="fw-semibold">@s.Title</a>
                                @if (s.IsSample)
                                {
                                    <span class="pill ms-1">Sample</span>
                                }
                                <div class="muted small">@string.Join(" & ", s.Participants.Select(p => p.User.Name))</div>
                            </div>
                            <div class="text-end small">
                                <div>@Local(s.StartedUtc, "ddd MMM d")</div>
                                @if (s.EndedUtc is { } end)
                                {
                                    <div class="muted">@Clock(end - s.StartedUtc)</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

@code {
    private sealed class StartState
    {
        public int? DayId { get; set; }
        public HashSet<string> People { get; set; } = [];
    }

    private bool loaded;
    private bool zoneChecked;
    private List<Schedule> schedules = [];
    private List<WorkoutSession> activeSessions = [];
    private List<WorkoutSession> recent = [];
    private List<WorkoutGroup> groups = [];
    private readonly Dictionary<int, StartState> pickers = [];

    protected override async Task OnInitializedAsync()
    {
        Live.SessionsChanged += OnSessionsChanged;
        await base.OnInitializedAsync();
    }

    protected override async Task LoadAsync()
    {
        schedules = await Schedules.GetSchedulesAsync(UserId);
        activeSessions = await Sessions.GetActiveAsync(UserId);
        recent = await Sessions.GetRecentAsync(UserId, 8);
        groups = await Groups.GetGroupsAsync(UserId);
        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!zoneChecked && CurrentUser is not null)
        {
            zoneChecked = true;
            if (!string.IsNullOrEmpty(CurrentUser.TimeZoneId))
            {
                return;
            }

            // Remember this device's time zone so dates display in local time.
            var zone = await JS.InvokeAsync<string>("gym.timeZone");
            if (!string.IsNullOrEmpty(zone) && TimeZoneInfo.TryFindSystemTimeZoneById(zone, out _))
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await db.Users.Where(u => u.Id == UserId).ExecuteUpdateAsync(u => u.SetProperty(x => x.TimeZoneId, zone));
                await RefreshUserAsync();
                await LoadAsync();
                StateHasChanged();
            }
        }
    }

    private StartState Picker(Schedule schedule)
    {
        if (!pickers.TryGetValue(schedule.Id, out var state))
        {
            state = new StartState
            {
                People = schedule.Group?.Members.Select(m => m.UserId).ToHashSet() ?? [UserId],
            };
            pickers[schedule.Id] = state;
        }

        return state;
    }

    private static void Toggle(StartState state, string id, bool on)
    {
        if (on)
        {
            state.People.Add(id);
        }
        else
        {
            state.People.Remove(id);
        }
    }

    private async Task Start(Schedule schedule, int dayId, StartState state)
    {
        if (state.People.Count == 0)
        {
            throw new InvalidOperationException("Pick at least one person.");
        }

        var id = await Sessions.StartAsync(UserId, schedule.Id, dayId, state.People.ToList());
        Nav.NavigateTo($"session/{id}");
    }

    private async Task CreateStarter()
    {
        var schedule = await Schedules.CreateStarterAsync(UserId, groups[0].Id);
        Notice = $"Created {schedule.Name}.";
    }

    private void OnSessionsChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Live refresh failed");
        }
    });

    public void Dispose() => Live.SessionsChanged -= OnSessionsChanged;
}

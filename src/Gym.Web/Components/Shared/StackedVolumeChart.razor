@* Combined volume per group session: one bar per session, one segment per person. *@

@if (Sessions.Count == 0)
{
    <div class="empty">No group sessions finished yet.</div>
}
else
{
    <div class="legend mb-1" aria-hidden="true">
        @foreach (var p in People)
        {
            <span class="key s@(p.Slot)"><span class="sw"></span>@p.Name</span>
        }
    </div>
    <svg class="chart" viewBox="0 0 @W @H" role="img" aria-label="Combined volume per group session">
        <g class="grid">
            @foreach (var tick in ticks)
            {
                <line x1="@Pad.L" x2="@(W - Pad.R)" y1="@F(Y(tick))" y2="@F(Y(tick))" />
            }
        </g>
        <g class="axis">
            @foreach (var tick in ticks)
            {
                @Text(Pad.L - 6, Y(tick) + 4, "end", Short(tick))
            }
            @Text(Pad.L, H - 4, "start", Format(shown[0].DateUtc))
            @if (shown.Count > 1)
            {
                @Text(W - Pad.R, H - 4, "end", Format(shown[^1].DateUtc))
            }
        </g>
        @for (var i = 0; i < shown.Count; i++)
        {
            var session = shown[i];
            var x = Pad.L + i * slot + (slot - barWidth) / 2;
            var top = 0m;
            foreach (var p in People)
            {
                var v = session.VolumeByUser.GetValueOrDefault(p.UserId);
                if (v <= 0)
                {
                    continue;
                }

                var y1 = Y(top + v);
                var y0 = Y(top);
                top += v;
                <g class="bar s@(p.Slot)">
                    <title>@Format(session.DateUtc) · @session.Title · @p.Name: @v.ToString("#,0") @Unit (group @session.Total.ToString("#,0"))</title>
                    <rect class="sbar" x="@F(x)" y="@F(y1)" width="@F(barWidth)" height="@F(Math.Max(1, y0 - y1))" rx="2" />
                </g>
            }
        }
    </svg>
    @if (Sessions.Count > shown.Count)
    {
        <div class="muted small">Showing the last @shown.Count of @Sessions.Count group sessions.</div>
    }
}

@code {
    public sealed record Person(string UserId, string Name, int Slot);

    [Parameter, EditorRequired] public IReadOnlyList<GroupSessionVolume> Sessions { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<Person> People { get; set; } = [];
    [Parameter] public Func<DateTime, DateTime> ToLocal { get; set; } = d => d;
    [Parameter] public string Unit { get; set; } = "lb";
    [Parameter] public int MaxBars { get; set; } = 24;

    private const int W = 640;
    private const int H = 220;
    private static readonly (int L, int R, int T, int B) Pad = (58, 8, 14, 28);
    private List<GroupSessionVolume> shown = [];
    private List<decimal> ticks = [];
    private decimal max;
    private double slot;
    private double barWidth;

    protected override void OnParametersSet()
    {
        shown = Sessions.TakeLast(MaxBars).ToList();
        if (shown.Count == 0)
        {
            return;
        }

        var ids = People.Select(p => p.UserId).ToHashSet();
        var hi = shown.Max(s => s.VolumeByUser.Where(kv => ids.Contains(kv.Key)).Sum(kv => kv.Value));
        var step = NiceStep(Math.Max(hi, 100) / 4);
        max = Math.Ceiling(Math.Max(hi, 1) / step) * step;
        ticks = [];
        for (var t = 0m; t <= max; t += step)
        {
            ticks.Add(t);
        }

        slot = (W - Pad.L - Pad.R) / (double)shown.Count;
        barWidth = Math.Min(28, slot * 0.7);
    }

    private static decimal NiceStep(decimal raw)
    {
        foreach (var s in new[] { 25m, 50m, 100m, 250m, 500m, 1000m, 2500m, 5000m, 10000m, 25000m })
        {
            if (raw <= s)
            {
                return s;
            }
        }

        return 50000m;
    }

    private double Y(decimal v) => max == 0 ? H - Pad.B : Pad.T + (double)((max - v) / max) * (H - Pad.T - Pad.B);

    private static string Short(decimal v) => v >= 1000 ? $"{v / 1000:0.#}k" : v.ToString("0");

    private static string F(double d) => d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static MarkupString Text(double x, double y, string anchor, string content) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    private string Format(DateTime utc) => ToLocal(utc).ToString("MMM d");
}
